{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:s1/:s2/:s3/:s4/:s5/:s6",
      "destination": "/api?s1=:s1&s2=:s2&s3=:s3&s4=:s4&s5=:s5&s6=:s6"
    },
    {
      "source": "/api/:s1/:s2/:s3/:s4/:s5",
      "destination": "/api?s1=:s1&s2=:s2&s3=:s3&s4=:s4&s5=:s5"
    },
    {
      "source": "/api/:s1/:s2/:s3/:s4",
      "destination": "/api?s1=:s1&s2=:s2&s3=:s3&s4=:s4"
    },
    {
      "source": "/api/:s1/:s2/:s3",
      "destination": "/api?s1=:s1&s2=:s2&s3=:s3"
    },
    {
      "source": "/api/:s1/:s2",
      "destination": "/api?s1=:s1&s2=:s2"
    },
    {
      "source": "/api/:s1",
      "destination": "/api?s1=:s1"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/musica",
      "destination": "/index.html"
    },
    {
      "source": "/musica/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/playlist/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/bio",
      "destination": "/index.html"
    },
    {
      "source": "/contacto",
      "destination": "/index.html"
    }
  ]
}
