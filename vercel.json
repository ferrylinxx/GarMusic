{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api?route=:route*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/musica",
      "destination": "/index.html"
    },
    {
      "source": "/musica/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/playlist/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/bio",
      "destination": "/index.html"
    },
    {
      "source": "/contacto",
      "destination": "/index.html"
    }
  ]
}
